# ==============================================================================
# CineStream Zero-Touch Configuration
# ==============================================================================
# Just fill in your DuckDNS, NAS path, and Provider credentials below.
# Everything else (API keys, SABnzbd SSL config, library folders, Let's Encrypt HTTPS)
# is automatically provisioned and linked on boot!
# ==============================================================================

# 1. Dynamic DNS & Free HTTPS (https://www.duckdns.org)
DUCKDNS_SUBDOMAIN=yoursubdomain
DUCKDNS_TOKEN=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# 2. NAS Storage Mount & Automated Config Backups
# Point to your local NAS share (e.g. /volume1/media or /mnt/storage).
# Movies, TV, and Downloads will be structured automatically under this mount.
NAS_HOST_PATH=/mnt/storage/media

# Host folder where daily automated backups of all server configs & databases are placed.
# Leave default or specify a folder on your host/NAS (e.g. /volume1/backups).
BACKUP_HOST_PATH=/mnt/storage/backups

# 3. Stream & Debrid Providers
# TorBox API Key (https://torbox.app/settings)
TORBOX_API_KEY=
# Premiumize API Key (https://www.premiumize.me/account)
PREMIUMIZE_API_KEY=
# Easynews NNTP & Web Search (https://account.easynews.com)
EASYNEWS_USERNAME=
EASYNEWS_PASSWORD=

# 4. Metadata
# TMDB API v3 Key (https://www.themoviedb.org/settings/api)
TMDB_API_KEY=your_tmdb_v3_api_key_here
DEFAULT_COUNTRY=ZA

# ==============================================================================
# Advanced / Optional Overrides (Defaults work out of the box)
# ==============================================================================
PUID=1000
PGID=1000
TZ=Etc/UTC

# Portainer internal web ports
CINESTREAM_PORT=3000
AIOSTREAMS_PORT=3001
RADARR_PORT=7878
SONARR_PORT=8989
PROWLARR_PORT=9696
SABNZBD_PORT=8080

# Multi-Threaded Streaming Proxy Tuning
NAS_MAX_CONCURRENT_DOWNLOADS=2
NAS_THREADS_PER_DOWNLOAD=6
PROXY_CONNECTIONS=8
PROXY_CHUNK_SIZE_MB=8
PROXY_READAHEAD_MB=64
