# ==============================================================================
# CineStream Zero-Touch Configuration
# ==============================================================================
# Copy this file to `.env` in the same directory as portainer-stack.yml.
# Replace the sample values below with your actual credentials.
#
# Everything else (API keys, Radarr/Sonarr linking, SABnzbd SSL config,
# library root folders, Let's Encrypt HTTPS certificates, and daily backups)
# is automatically provisioned and linked on boot!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Dynamic DNS & Automatic Free HTTPS (https://www.duckdns.org)
# ------------------------------------------------------------------------------
# Subdomain name only (e.g. if your domain is "mycinestream.duckdns.org", enter "mycinestream")
# Caddy will automatically acquire and renew a valid Let's Encrypt SSL certificate for it.
DUCKDNS_SUBDOMAIN=mycinestream

# Your DuckDNS account token (UUID format found at top of duckdns.org dashboard)
DUCKDNS_TOKEN=a1b2c3d4-e5f6-7a8b-9c0d-1e2f3a4b5c6d

# ------------------------------------------------------------------------------
# 2. Host Storage Mount & Automated Config Backups
# ------------------------------------------------------------------------------
# Exact path to your storage drive on the host machine.
# CineStream, Radarr, Sonarr, and SABnzbd all share this unified mount.
# Subfolders (/movies, /tv, /downloads) are auto-created inside this directory.
# Example: /mnt/1tb/nas or /volume1/media or /mnt/storage/media
NAS_HOST_PATH=/mnt/1tb/nas

# Host folder where daily automated backups of all server configs & databases are placed.
# CineStream automatically creates /cinestream, /radarr, /sonarr, /sabnzbd, /aiostreams
# snapshots with 14-day rolling retention.
# Example: /mnt/1tb/backups or /volume1/backups
BACKUP_HOST_PATH=/mnt/1tb/backups

# ------------------------------------------------------------------------------
# 3. Stream & Debrid Providers (Enter at least one)
# ------------------------------------------------------------------------------
# TorBox API Key (Found under Account Settings -> API at https://torbox.app/settings)
# Example: tb_live_1234567890abcdef1234567890abcdef
TORBOX_API_KEY=tb_live_your_torbox_api_key_here

# Premiumize API Key (Found under Account -> API Key at https://www.premiumize.me/account)
# Example: abcdef1234567890abcdef12
PREMIUMIZE_API_KEY=your_premiumize_api_key_here

# Easynews NNTP & Web Search (Your Easynews login at https://account.easynews.com)
# Used for instant direct streaming, and auto-configures SABnzbd on SSL port 563.
EASYNEWS_USERNAME=your_easynews_username
EASYNEWS_PASSWORD=your_easynews_password

# ------------------------------------------------------------------------------
# 4. Movie & TV Metadata
# ------------------------------------------------------------------------------
# TMDB API v3 Key (Free at https://www.themoviedb.org/settings/api)
# Example: 1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d
TMDB_API_KEY=your_tmdb_v3_api_key_here

# ISO 3166-1 alpha-2 country code for local catalog certification ratings (e.g. US, GB, ZA, CA, AU)
DEFAULT_COUNTRY=ZA

# ==============================================================================
# Advanced / Optional Overrides (Defaults work out of the box)
# ==============================================================================
# LinuxServer container file permissions (Match your host user: run `id -u` and `id -g`)
PUID=1000
PGID=1000
TZ=Etc/UTC

# Portainer internal web ports (Change only if you have conflicting services on your host)
CINESTREAM_PORT=3000
AIOSTREAMS_PORT=3001
RADARR_PORT=7878
SONARR_PORT=8989
PROWLARR_PORT=9696
SABNZBD_PORT=8080

# Multi-Threaded Live Streaming Proxy & NAS Downloader Tuning
NAS_MAX_CONCURRENT_DOWNLOADS=2
NAS_THREADS_PER_DOWNLOAD=6
PROXY_CONNECTIONS=8
PROXY_CHUNK_SIZE_MB=8
PROXY_READAHEAD_MB=64
