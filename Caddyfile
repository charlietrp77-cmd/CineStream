{
    email {$ACME_EMAIL:admin@cinestream.local}
}

# When DUCKDNS_SUBDOMAIN is configured, Caddy automatically acquires and renews free Let's Encrypt HTTPS certificates
{$DUCKDNS_SUBDOMAIN:localhost}.duckdns.org {
    reverse_proxy cinestream:3000
}

# Local LAN HTTP access fallback
:80 {
    reverse_proxy cinestream:3000
}

